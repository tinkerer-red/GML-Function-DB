{
    "schema_version":  1,
    "heuristics":  [
                       {
                           "name":  "getter_name_missing_getter",
                           "description":  "Names that look like getters but are not marked is_getter.",
                           "source":  "db",
                           "any":  [
                                       "function_name~=(^get_|_get_|_get$|^is_|_is_|_is$|_exists$|^has_|_has_)"
                                   ],
                           "none":  [
                                        "is_getter",
                                        "function_name=http_get",
                                        "function_name~=(^buffer_get_surface(_depth)?$|^iap_(product|purchase)_details$|^skeleton_(bone_(data|state)_get|find_slot)$)",
                                        "category_path~Rollback",
                                        "is_deprecated",
                                        "peer_reviewed"
                                    ],
                           "fields":  [
                                          "function_name",
                                          "return_type",
                                          "is_getter",
                                          "is_setter",
                                          "category_path",
                                          "db_path"
                                      ]
                       },
                       {
                           "name":  "setter_name_missing_setter",
